# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Optional environment variables for Vercel deployment & OAuth:
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"
GOOGLE_REDIRECT_URI="https://rdu-clinics-satun.vercel.app/api/auth/google/callback"

LINE_CHANNEL_ID="your-line-channel-id"
LINE_CHANNEL_SECRET="your-line-channel-secret"
LINE_REDIRECT_URI="https://rdu-clinics-satun.vercel.app/api/auth/line/callback"

JWT_SECRET="replace-with-a-long-random-secret"

VITE_GAS_WEB_APP_URL="https://script.google.com/macros/s/.../exec"
VITE_SPREADSHEET_ID="1yLfjRD0PGXLJpsCyM8F9HsJfgb5gaDLAGhUjiB_eUY4"
TELEGRAM_BOT_TOKEN="your-telegram-bot-token"
TELEGRAM_CHAT_ID="your-telegram-group-chat-id"
DASHBOARD_URL="https://rdu-clinics-satun.vercel.app"

# Required for a private sheet and persistent user management. Share the sheet as
# Editor with GOOGLE_SERVICE_ACCOUNT_EMAIL. Multiline keys may use literal \n.
GOOGLE_SERVICE_ACCOUNT_EMAIL="rdu-sheets-reader@your-project.iam.gserviceaccount.com"
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Optional: store SystemUsers in a separate spreadsheet.
USER_SPREADSHEET_ID="1yLfjRD0PGXLJpsCyM8F9HsJfgb5gaDLAGhUjiB_eUY4"
