# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Optional environment variables for Vercel deployment & OAuth:
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"
GOOGLE_REDIRECT_URI="https://rdu-clinics-satun.vercel.app/api/auth/google/callback"

LINE_CHANNEL_ID="your-line-channel-id"
LINE_CHANNEL_SECRET="your-line-channel-secret"
LINE_REDIRECT_URI="https://rdu-clinics-satun.vercel.app/api/auth/line/callback"

JWT_SECRET="replace-with-a-long-random-secret"

# Comma-separated allowlists. Unknown accounts can authenticate but remain pending.
ADMIN_GOOGLE_EMAILS="satun.rdu.admin@gmail.com"
SUPER_ADMIN_GOOGLE_EMAILS="akaporn1234@gmail.com"
ADMIN_LINE_USER_IDS="Uxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
SUPER_ADMIN_LINE_USER_IDS="moozuzaboy"

VITE_GAS_WEB_APP_URL="https://script.google.com/macros/s/.../exec"
VITE_SPREADSHEET_ID="1yLfjRD0PGXLJpsCyM8F9HsJfgb5gaDLAGhUjiB_eUY4"
VITE_TELEGRAM_BOT_TOKEN="8642457774:AAEssByKIIelsFpDnkz9ridr-IT--J2Ap9I"
VITE_TELEGRAM_CHAT_ID="-5319646324"

# Optional: use these when the Google Sheet is private. Share the sheet as
# Viewer with GOOGLE_SERVICE_ACCOUNT_EMAIL. Multiline keys may use literal \n.
GOOGLE_SERVICE_ACCOUNT_EMAIL="rdu-sheets-reader@your-project.iam.gserviceaccount.com"
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
